<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PhotoStudio.Desktop.App" RequestedThemeVariant="Light">
 <Application.Styles>
  <FluentTheme />
  <Style Selector="Window"><Setter Property="FontFamily" Value="avares://PhotoStudio.Desktop/Assets#DejaVu Sans"/><Setter Property="FontSize" Value="16"/><Setter Property="Background" Value="#F5F7FA"/></Style>
  <Style Selector="Button"><Setter Property="Padding" Value="18,11"/><Setter Property="CornerRadius" Value="6"/><Setter Property="MinHeight" Value="42"/></Style>
  <Style Selector="Button.accent"><Setter Property="Background" Value="#365D82"/><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="Button.nav"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="10,10"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#1F2937"/></Style>
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="42"/></Style>
  <Style Selector="ComboBox"><Setter Property="MinHeight" Value="42"/></Style>
 </Application.Styles>
</Application>
